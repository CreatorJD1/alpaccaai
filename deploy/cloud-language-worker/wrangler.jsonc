{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "alpecca-cloud-language",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "preview_urls": false,
  "ai": {
    "binding": "AI"
  },
  "secrets": {
    "required": ["LANGUAGE_AUTH_SECRET"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
